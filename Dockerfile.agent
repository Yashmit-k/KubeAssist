# syntax=docker/dockerfile:1
# Same multi-stage pattern as the main Dockerfile, building cmd/agent
# instead of cmd/server. This image is meant to be deployed INSIDE a
# customer's cluster, not alongside the main backend.
FROM golang:1.23-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/agent ./cmd/agent

FROM gcr.io/distroless/static-debian12
COPY --from=build /out/agent /agent
ENTRYPOINT ["/agent"]
