# Copy to .env (never commit .env).

# Shared secret between the Go backend and the AI service.
AI_SHARED_TOKEN=change-me-to-a-long-random-string
POSTGRES_PASSWORD=kubeassist_dev_password

# LLM: any OpenAI-compatible endpoint. With LLM_MOCK=true (or no key) the
# AI service returns curated playbook answers with real doc retrieval.
LLM_MOCK=true
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Keyless local model (e.g. Ollama on the host):
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=llama3.1
# LLM_REQUIRE_KEY=false

# What agents dial. Behind TLS in production: wss://your-domain/agent/connect
RELAY_PUBLIC_URL=ws://localhost:8080/agent/connect
# Optional operator credential: lists every cluster and reaches any of them.
ADMIN_TOKEN=

# Accounts. PUBLIC_URL is the UI's browser-facing origin. Create a GitHub
# OAuth App with callback URL $PUBLIC_URL/api/auth/github/callback.
PUBLIC_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Enables fix pull requests (users connect GitHub repositories). Generate
# with: openssl rand -base64 32 — keep it secret and don't change it, or
# stored repository tokens can no longer be decrypted.
GITHUB_TOKEN_KEY=
# Alerts: scan interval for clusters with alerts enabled (min 15s).
ALERT_INTERVAL=60s
# Lets alert webhooks target http:// and private addresses. Local testing only.
ALERTS_ALLOW_PRIVATE_WEBHOOKS=false

# Password-less "sign in as any username" for local development only.
# Refused when PUBLIC_URL is https.
AUTH_DEV_LOGIN=true

# Kind cluster name used by `make up-kind` / `make agent-kind`.
KIND_CLUSTER=kubeassist-dev
