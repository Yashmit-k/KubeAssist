HOST=0.0.0.0
PORT=8000
# Shared secret; the Go backend sends it as AI_AUTH_TOKEN.
AI_SHARED_TOKEN=dev-shared-token-change-me

# LLM (any OpenAI-compatible /chat/completions endpoint).
# LLM_MOCK=true (or no key) returns curated playbook answers with real retrieval.
LLM_MOCK=true
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=60
# For keyless local servers (Ollama: LLM_BASE_URL=http://localhost:11434/v1):
# LLM_REQUIRE_KEY=false

RAG_TOP_K=5
